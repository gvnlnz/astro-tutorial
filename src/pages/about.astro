---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "About me";

const identity = {
	fName: "Gavio",
	country: "Italy",
	job: "Developer",
	hobbies: ["hobby 1", "hobby 2", "hobby 3"],
};

const skills = ["Laravel", "Astro", "React", "Python", "C"];

const happy = true;
const finished = false;
const goal = 3;

// CSS variable
const skillColor = "red";
const fontWeight = "bold";
const textCase = "uppercase";
---

<html>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<style define:vars={{ skillColor, fontWeight, textCase }}>
			h1 {
				color: purple;
				font-size: 4rem;
			}

			.skill {
				color: var(--skillColor);
				font-weight: var(--fontWeight);
				text-transform: var(--textCase);
			}

			.hobby {
				color: orange;
				font-weight: var(--fontWeight);
			}
		</style>
	</head>

	<body>
		<Header />
		
		<h1>{pageTitle}</h1>

		<p>Here are some info's about me:</p>
		<ul>
			<li>My name is {identity.fName}</li>
			<li>I live in {identity.country}</li>
			<li>I work as {identity.job}</li>
			{identity.hobbies.length > 0 && (
				<li>
					My hobbies are:{" "}
					{identity.hobbies.map((hobby) => (
						<li class="hobby">{hobby}</li>
					))}
				</li>
			)}
			<br />
			<li>My main programming languages are:</li>
			{skills.map((skill) => (
				<li class="skill">{skill}</li>
			))}

			{happy && <p>I'm happy to learn Astro!</p>}
			{finished && <p>Ho finito il tutorial</p>}
			{goal == 3 ? (
				<p>My goal is to close in 3 days.</p>
			) : (
				<p>My goal is to close in 3 days.</p>
			)}
        </ul>
        
        <Footer />

  		<script>
			import "../scripts/menu.js";
		</script>
	</body>
</html>
